<UserControl x:Class="DiskInspector.App.Views.DetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskInspector.App.ViewModels"
             xmlns:c="clr-namespace:DiskInspector.App.Controls">
    <Border Style="{StaticResource Card}" Padding="16">
        <Grid>
            <TextBlock Style="{StaticResource Muted}" Text="Select a file or folder in any view to see its details here."
                       Visibility="{Binding Details, Converter={StaticResource EmptyToVis}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Details, Converter={StaticResource NotEmptyToVis}}">
                <StackPanel DataContext="{Binding Details}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Style="{StaticResource Swatch}" Background="{Binding Brush}" Width="14" Height="14" />
                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,6,0,12" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Size" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding SizeText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding BytesText}" Style="{StaticResource Muted}" FontSize="12" />
                    <TextBlock Text="{Binding ShareText}" Style="{StaticResource Muted}" Margin="0,2,0,10" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="On disk" Style="{StaticResource Muted}" Margin="0,0,16,4" />
                        <TextBlock Grid.Column="1" Text="{Binding AllocatedText}" />
                        <TextBlock Grid.Row="1" Text="Contents" Style="{StaticResource Muted}" Margin="0,0,16,4"
                                   Visibility="{Binding ContentsText, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ContentsText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Modified" Style="{StaticResource Muted}" Margin="0,0,16,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ModifiedText}" />
                    </Grid>

                    <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
                    </Border>

                    <WrapPanel Margin="0,0,0,16">
                        <Button Command="{Binding DataContext.OpenSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6"
                                ToolTip="Open with the default app (disabled for programs and scripts)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,6,0" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.RevealSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEC50;" Margin="0,0,6,0" />
                                <TextBlock Text="Show in Explorer" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.CopySelectedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,6,0" />
                                <TextBlock Text="Copy path" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="What's inside" Style="{StaticResource SubHeading}" />
                        <ItemsControl ItemsSource="{Binding Breakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:BreakdownItem">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource Muted}" />
                                        <c:ProportionBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Fraction}" Fill="{Binding Brush}" Height="6" Margin="0,3,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
