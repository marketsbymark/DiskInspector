<UserControl x:Class="DiskInspector.App.Views.LargestFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskInspector.App.ViewModels"
             xmlns:c="clr-namespace:DiskInspector.App.Controls">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox Width="240" Margin="0,0,8,4" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Show only files whose name contains this text" />
            <ComboBox Width="200" Margin="0,0,8,4" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Label" />
            <ComboBox Width="210" Margin="0,0,12,4" ItemsSource="{x:Static vm:LargestFilesViewModel.AgeOptions}" SelectedItem="{Binding AgeFilter}" DisplayMemberPath="Label" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,4" />
            <ProgressBar Width="80" Height="4" Margin="12,0,0,4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="2,0,0,8" Text="Type in the box to filter by name." />
        <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" c:GridViewSort.Enabled="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ContextMenu="{StaticResource NodeMenu}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="300" c:GridViewSort.Property="Name">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="vm:FileRow">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Swatch}" Background="{Binding CategoryBrush}" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Size" Width="95" c:GridViewSort.Property="Size">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="vm:FileRow">
                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="On disk" Width="95" c:GridViewSort.Property="Allocated">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="vm:FileRow">
                                <TextBlock Text="{Binding AllocatedText}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Category" Width="140" DisplayMemberBinding="{Binding Category}" c:GridViewSort.Property="Category" />
                    <GridViewColumn Header="Modified" Width="130" DisplayMemberBinding="{Binding ModifiedText}" c:GridViewSort.Property="Modified" />
                    <GridViewColumn Header="Folder" Width="560" DisplayMemberBinding="{Binding Folder}" c:GridViewSort.Property="Folder" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
