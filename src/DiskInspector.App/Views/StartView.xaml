<UserControl x:Class="DiskInspector.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskInspector.App.ViewModels"
             xmlns:c="clr-namespace:DiskInspector.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,40,32,32">
            <TextBlock Text="What is filling up your drive?" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,24"
                       Text="Pick a drive to scan. DiskInspector maps every file by size and groups them by type, category, location and age. It only reads folder listings: nothing on your disk is changed." />

            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DriveItem">
                        <Button Width="270" Margin="0,0,12,12" Padding="16" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.ScanDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="Scan this drive">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="26" Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Format}" Style="{StaticResource Muted}" />
                                    </StackPanel>
                                </StackPanel>
                                <c:ProportionBar Value="{Binding UsedFraction}" Height="6" Margin="0,12,0,6" />
                                <TextBlock Text="{Binding UsageText}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Two ways to scan" Style="{StaticResource SubHeading}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,6">
                        <Run FontWeight="SemiBold" Text="Scan" /> works for any drive or folder without admin rights. A full C:\ drive usually takes under a minute. A few protected system folders are skipped and listed.
                    </TextBlock>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run FontWeight="SemiBold" Text="Fast scan" /> reads the NTFS file table directly. It finishes in seconds and sees protected folders too, but Windows asks for administrator permission first. If it cannot run, the normal scan is used automatically.
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
