<UserControl x:Class="DiskInspector.App.Views.ScopeBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext is any view model with a Main property (or MainViewModel itself). -->
    <Border Padding="10,6" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding Main.ScopeToSelectionCommand}" Margin="6,0,0,0" Padding="10,3"
                        ToolTip="Limit this view to the folder selected in any view (or the folder holding the selected file)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Use selected folder" FontSize="12" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding Main.ScopeToEverythingCommand}" Margin="6,0,0,0" Padding="10,3"
                        Visibility="{Binding Main.IsScoped, Converter={StaticResource BoolToVis}}" ToolTip="Show everything that was scanned again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Everything" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,8,0" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="Showing:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Run Text="{Binding Main.ScopeText, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>
