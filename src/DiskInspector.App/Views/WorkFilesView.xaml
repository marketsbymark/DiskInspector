<UserControl x:Class="DiskInspector.App.Views.WorkFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskInspector.App.ViewModels"
             xmlns:v="clr-namespace:DiskInspector.App.Views"
             xmlns:c="clr-namespace:DiskInspector.App.Controls">
    <DockPanel>
        <v:ScopeBar DockPanel.Dock="Top" />

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox Width="250" Margin="0,0,8,6" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" DisplayMemberPath="Label"
                      ToolTip="Which kind of work file to list" />
            <ComboBox Width="170" Margin="0,0,8,6" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label"
                      ToolTip="All types in the group, or one type on its own" />
            <TextBox Width="200" Margin="0,0,8,6" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Show only files whose name contains this text" />
            <CheckBox Content="Only my files" IsChecked="{Binding OnlyUserFolders}" Margin="0,0,12,6" VerticalAlignment="Center"
                      ToolTip="Skip Windows, Program Files, ProgramData, AppData and package or cache folders (node_modules, site-packages, .git, ...)" />
            <Button Command="{Binding Main.SnapshotCommand}" Margin="0,0,6,6" ToolTip="Save this table as a CSV file in the snapshot folder">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Snapshot table" />
                </StackPanel>
            </Button>
            <Button Command="{Binding Main.SnapshotAllWorkFilesCommand}" Margin="0,0,6,6"
                    ToolTip="Save one CSV per group (Excel, CSV, Word, PowerPoint, PDF, email, Markdown, notebooks, Python, DBC, help files) plus a summary, in a new folder">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" FontSize="14" Margin="0,0,6,0" />
                    <TextBlock Text="Snapshot all groups" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ReadAuthorsCommand}" Padding="10,3" Margin="6,0,0,0"
                        ToolTip="Read author, last saved by and title from the files in this table. Files are opened read-only, their last-accessed date is not changed, and online-only files are skipped.">
                    <TextBlock Text="Read authors" FontSize="12" />
                </Button>
                <Button Command="{Binding StopAuthorsCommand}" Padding="10,3" Margin="6,0,0,0"
                        Visibility="{Binding IsReadingAuthors, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Stop" FontSize="12" />
                </Button>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Left" Width="60" Height="4" Margin="0,0,10,0" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="   " />
                <Run Text="{Binding AuthorStatus, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </TextBlock>
        </DockPanel>

        <ListView ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" c:GridViewSort.Enabled="True"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ContextMenu="{StaticResource NodeMenu}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="260" c:GridViewSort.Property="Name">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="vm:WorkFileRow">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="60" DisplayMemberBinding="{Binding Type}" c:GridViewSort.Property="Type" />
                    <GridViewColumn Header="Size" Width="85" c:GridViewSort.Property="Size">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="vm:WorkFileRow">
                                <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Last saved" Width="130" DisplayMemberBinding="{Binding ModifiedText}" c:GridViewSort.Property="Modified" />
                    <GridViewColumn Header="Created" Width="130" DisplayMemberBinding="{Binding CreatedText}" c:GridViewSort.Property="Created" />
                    <GridViewColumn Header="Last accessed" Width="130" DisplayMemberBinding="{Binding AccessedText}" c:GridViewSort.Property="Accessed" />
                    <GridViewColumn Header="Author" Width="140" DisplayMemberBinding="{Binding Author}" c:GridViewSort.Property="Author" />
                    <GridViewColumn Header="Last saved by" Width="130" DisplayMemberBinding="{Binding LastSavedBy}" c:GridViewSort.Property="LastSavedBy" />
                    <GridViewColumn Header="Where" Width="95" DisplayMemberBinding="{Binding Availability}" c:GridViewSort.Property="Availability" />
                    <GridViewColumn Header="Folder" Width="480" DisplayMemberBinding="{Binding Folder}" c:GridViewSort.Property="Folder" />
                    <GridViewColumn Header="Title / subject" Width="220" DisplayMemberBinding="{Binding Title}" c:GridViewSort.Property="Title" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
