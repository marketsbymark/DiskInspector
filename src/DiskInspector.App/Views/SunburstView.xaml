<UserControl x:Class="DiskInspector.App.Views.SunburstView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DiskInspector.App.ViewModels"
             xmlns:core="clr-namespace:DiskInspector.Core.Analysis;assembly=DiskInspector.Core"
             xmlns:c="clr-namespace:DiskInspector.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Command="{Binding SunburstUpCommand}" ToolTip="Up one folder (Backspace)" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE74A;" />
            </Button>
            <ItemsControl ItemsSource="{Binding SunburstCrumbs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:Crumb">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Name}" Padding="6,2" Background="Transparent" BorderThickness="0"
                                    Command="{Binding DataContext.GoToSunburstRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Node}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>

        <c:SunburstControl Grid.Row="1" Tree="{Binding Tree}" Colors="{Binding Colors}" Metric="{Binding Metric}"
                           RootNode="{Binding SunburstRoot, Mode=TwoWay}" SelectedNode="{Binding SelectedNode, Mode=TwoWay}"
                           HoveredNode="{Binding HoveredNode, Mode=TwoWay}" ContextMenu="{StaticResource NodeMenu}" />

        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="2,8,0,4"
                   Text="Click a slice to select it. Double-click a folder to put it in the middle. Click the middle to go up. Grey slices group items too small to show." />

        <ItemsControl Grid.Row="3" ItemsSource="{Binding Legend}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="core:Category">
                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                        <Border Style="{StaticResource Swatch}" Background="{Binding Color, Converter={x:Static c:ColorToBrush.Instance}}" />
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
