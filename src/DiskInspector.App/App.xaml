<Application x:Class="DiskInspector.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DiskInspector.App.Controls"
             ThemeMode="System"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <c:LevelToIndentConverter x:Key="LevelToIndent" />
        <c:IndexToVisibilityConverter x:Key="IndexToVis" />
        <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />
        <c:EmptyToVisibilityConverter x:Key="NotEmptyToVis" Invert="True" />

        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Right-click menu for any file or folder. Bound to MainViewModel through each view model's Main property. -->
        <ContextMenu x:Key="NodeMenu" x:Shared="False">
            <MenuItem Header="Open" Command="{Binding Main.OpenSelectedCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in File Explorer" Command="{Binding Main.RevealSelectedCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xEC50;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy path" Command="{Binding Main.CopySelectedPathCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="File types in this folder" Command="{Binding Main.AnalyzeSelectedFolderCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in treemap" Command="{Binding Main.ShowInTreemapCommand}">
                <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Application.Resources>
</Application>
